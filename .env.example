# =============================================================================
# StayNest - Environment Variables (Template)
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit a real .env file with secrets.
# Development credentials below are for LOCAL use only.

# --- Application ---
PORT=3000
NODE_ENV=development

# --- PostgreSQL (Phase 1+) ---
DATABASE_URL=postgresql://staynest:staynest_pass@localhost:5432/staynest
POSTGRES_DB=staynest
POSTGRES_USER=staynest
POSTGRES_PASSWORD=staynest_pass

# --- Redis (Phase 1+) ---
REDIS_URL=redis://localhost:6379

# --- MinIO (Phase 1+) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=staynest

# --- API Configuration (Phase 2+) ---
CORS_ORIGIN=http://localhost:3000
API_PREFIX=api/v1

# --- Web frontend (used for post-payment redirects) ---
WEB_APP_URL=http://localhost:3001

# --- JazzCash (Phase 7+) ---
# JAZZCASH_RETURN_URL must point at the API callback endpoint, NOT a frontend
# route. JazzCash POSTs the result there; the backend verifies the secure hash,
# applies the payment/booking state transition, then redirects the browser to
# WEB_APP_URL/payments?status=success|failure
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_RETURN_URL=http://localhost:3000/api/v1/payments/jazzcash/callback
JAZZCASH_SANDBOX=true

# --- Safepay (Phase 7+) ---
# SAFEPAY_REDIRECT_URL must point at the API callback endpoint, NOT a
# frontend route. Safepay returns the guest there; the backend verifies
# the HMAC-SHA256 redirect signature, applies the payment/booking state
# transition, then redirects the browser to WEB_APP_URL/payments.
# SAFEPAY_API_KEY is the public API key (sec_...); SAFEPAY_SECRET is the
# shared secret used only to verify the redirect signature.
SAFEPAY_API_KEY=
SAFEPAY_SECRET=
SAFEPAY_REDIRECT_URL=http://localhost:3000/api/v1/payments/safepay/callback
SAFEPAY_CANCEL_URL=http://localhost:3001/payments
SAFEPAY_SANDBOX=true

# --- JWT (Phase 3+) ---
JWT_SECRET=changeme-generate-a-secure-secret
JWT_EXPIRES_IN=7d

# --- Stripe (Phase 6+) - TEST MODE ONLY ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (Phase 6+) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=