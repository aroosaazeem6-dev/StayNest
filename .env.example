# =============================================================================
# StayNest - Environment Variables (Template)
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit a real .env file with secrets.

# --- Application ---
PORT=3000
NODE_ENV=development

# --- Database (Phase 1+) ---
DATABASE_URL=postgresql://user:password@localhost:5432/staynest

# --- Redis (Phase 1+) ---
REDIS_URL=redis://localhost:6379

# --- MinIO (Phase 8+) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=staynest

# --- JWT (Phase 3+) ---
JWT_SECRET=changeme-generate-a-secure-secret
JWT_EXPIRES_IN=7d

# --- Stripe (Phase 6+) - TEST MODE ONLY ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (Phase 6+) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
