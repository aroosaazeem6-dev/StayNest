# =============================================================================
# StayNest - Environment Variables (Template)
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit a real .env file with secrets.
# Development credentials below are for LOCAL use only.

# --- Application ---
PORT=3000
NODE_ENV=development

# --- PostgreSQL (Phase 1+) ---
DATABASE_URL=postgresql://staynest:staynest_pass@localhost:5432/staynest
POSTGRES_DB=staynest
POSTGRES_USER=staynest
POSTGRES_PASSWORD=staynest_pass

# --- Redis (Phase 1+) ---
REDIS_URL=redis://localhost:6379

# --- MinIO (Phase 1+) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=staynest

# --- JWT (Phase 3+) ---
JWT_SECRET=changeme-generate-a-secure-secret
JWT_EXPIRES_IN=7d

# --- Stripe (Phase 6+) - TEST MODE ONLY ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (Phase 6+) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=