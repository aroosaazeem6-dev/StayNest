# =============================================================================
# StayNest API - Dockerfile (Phase 12 will finalize this)
# =============================================================================
# This is a skeleton Dockerfile for future containerization.
# It is not used during Phase 1 development.
# =============================================================================

# Build stage
FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# Production stage
FROM node:20-alpine AS production
WORKDIR /app
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY apps/api/prisma/schema.prisma prisma/schema.prisma
EXPOSE 3000
CMD ["node", "dist/main"]